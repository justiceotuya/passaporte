# Anthropic key for Phase 2 live vision (do not commit the real .env)
ANTHROPIC_API_KEY=

# Better Auth
BETTER_AUTH_SECRET=dev-only-change-me-use-32-chars-min
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth (optional — enables "Continue with Google")
# Create OAuth client in Google Cloud Console; redirect URI:
#   {BETTER_AUTH_URL}/api/auth/callback/google
# Also set the same vars on the Convex deployment when using Convex auth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Convex (fill after `cd apps/web && npx convex login && npx convex dev`)
# CONVEX_DEPLOYMENT=dev:adjective-animal-123
# NEXT_PUBLIC_CONVEX_URL=https://adjective-animal-123.convex.cloud
# NEXT_PUBLIC_CONVEX_SITE_URL=https://adjective-animal-123.convex.site

# Admin content review
# PASSAPORTE_ADMIN_EMAILS=you@example.com
# PASSAPORTE_ADMIN_BYPASS=1
