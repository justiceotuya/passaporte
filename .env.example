# Anthropic key for Phase 2 live vision (do not commit the real .env)
ANTHROPIC_API_KEY=

# Better Auth
BETTER_AUTH_SECRET=dev-only-change-me-use-32-chars-min
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth (optional — enables "Continue with Google")
# Create OAuth client in Google Cloud Console; redirect URI:
#   {BETTER_AUTH_URL}/api/auth/callback/google
# Also set the same vars on the Convex deployment when using Convex auth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Password reset email (optional — enables real delivery via Resend)
# Without RESEND_API_KEY, forgot-password still works: the reset URL is logged
# in the server console and the UI notes that email is not configured.
# Create an API key at https://resend.com — verify your domain for production.
# For Convex auth, also set these on the deployment:
#   pnpm exec convex env set RESEND_API_KEY "re_…"
#   pnpm exec convex env set AUTH_EMAIL_FROM "Passaporte <noreply@yourdomain.com>"
RESEND_API_KEY=
AUTH_EMAIL_FROM=Passaporte <onboarding@resend.dev>
# SMTP is not wired yet; use Resend HTTP API above.

# Convex (fill after `cd apps/web && npx convex login && npx convex dev`)
# CONVEX_DEPLOYMENT=dev:adjective-animal-123
# NEXT_PUBLIC_CONVEX_URL=https://adjective-animal-123.convex.cloud
# NEXT_PUBLIC_CONVEX_SITE_URL=https://adjective-animal-123.convex.site

# Invite-only signup (comma-separated). Empty = open in dev, closed in production.
# Also set on Convex: cd apps/web && pnpm exec convex env set PASSAPORTE_ALLOWED_EMAILS you@example.com
PASSAPORTE_ALLOWED_EMAILS=

# Optional: read units from somewhere other than content/local/passaporte or content/sample
# PASSAPORTE_CONTENT_DIR=content/local/passaporte

# Admin content review
# PASSAPORTE_ADMIN_EMAILS=you@example.com
# PASSAPORTE_ADMIN_BYPASS=1
