{
  "name": "passaporte",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "smoke:scaffold": "bash scripts/smoke-scaffold.sh",
    "test:schema": "pnpm --filter @passaporte/web exec vitest run schema && cd pipeline && uv run pytest tests/test_schema.py -q",
    "test:phase0": "pnpm smoke:scaffold",
    "test:phase1": "pnpm test:schema",
    "test:web": "pnpm --filter @passaporte/web exec vitest run",
    "content:validate": "pnpm --filter @passaporte/web exec node ./scripts/validate-content.mjs",
    "content:ship-gate": "node scripts/ship-gate.mjs",
    "content:approve-unit": "node scripts/approve-unit.mjs",
    "web": "pnpm --filter @passaporte/web dev",
    "web:test": "pnpm --filter @passaporte/web exec vitest run",
    "web:e2e": "pnpm --filter @passaporte/web exec playwright test",
    "web:convex": "pnpm --filter @passaporte/web exec convex dev",
    "pipeline:test": "cd pipeline && uv run pytest -q",
    "pipeline:join": "cd pipeline && uv run python join.py --report ../extracted/join_report.md",
    "pipeline:hints": "cd pipeline && uv run python hints.py",
    "pipeline:crop": "cd pipeline && uv run python crop.py"
  },
  "engines": {
    "node": ">=20"
  }
}
