#!/usr/bin/env bash
# Strip Cursor attribution trailers Cursor Agent may inject into commit messages.
# Installed via: git config core.hooksPath .githooks  (see scripts/install-git-hooks.sh)

set -euo pipefail

msg_file="${1:-}"
[[ -n "$msg_file" && -f "$msg_file" ]] || exit 0

# Do not touch merge/squash message templates aggressively; still strip Cursor lines.
python3 - "$msg_file" <<'PY'
import pathlib
import re
import sys

path = pathlib.Path(sys.argv[1])
text = path.read_text(encoding="utf-8")
patterns = [
    re.compile(r"^Co-authored-by:\s*Cursor\b.*\n?", re.IGNORECASE | re.MULTILINE),
    re.compile(r"^Co-authored-by:\s*.*<cursoragent@cursor\.com>.*\n?", re.IGNORECASE | re.MULTILINE),
    re.compile(r"^Made-with:\s*Cursor\s*\n?", re.IGNORECASE | re.MULTILINE),
    re.compile(r"^Made with Cursor\s*\n?", re.IGNORECASE | re.MULTILINE),
]
cleaned = text
for pattern in patterns:
    cleaned = pattern.sub("", cleaned)
# Collapse excess blank lines left by removals (keep a single trailing newline).
cleaned = re.sub(r"\n{3,}", "\n\n", cleaned).rstrip() + "\n"
if cleaned != text:
    path.write_text(cleaned, encoding="utf-8")
PY
